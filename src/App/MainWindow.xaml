<Window x:Class="TimeTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IFS Time Tracker" Width="372" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.30" Color="#20283C"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource Surface2}"
                    CornerRadius="12,12,0,0" Height="38" MouseLeftButtonDown="TitleBar_Drag">
                <Grid Margin="14,0,8,0">
                    <TextBlock Text="IFS Time Tracker" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Click="Minimize_Click" Style="{StaticResource IconBtn}" FontSize="13"/>
                        <Button Content="✕" Click="HideToTray_Click" Style="{StaticResource IconBtn}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- body -->
            <StackPanel Grid.Row="1" Margin="18,16,18,16">
                <!-- live card -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" x:Name="LiveDot" Width="34" Height="34"
                             Fill="{DynamicResource TextFaint}"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LiveCode" Text="Not tracking" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}"/>
                            <Border x:Name="RecBadge" Margin="8,0,0,0" Padding="5,1" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{DynamicResource Live}" Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                <TextBlock Text="REC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Live}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LiveAsn" Text="Select a project to begin" FontSize="12"
                                   Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="PrimaryBtn" Width="44" Height="44" Click="Primary_Click"
                            Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="pb" CornerRadius="22" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="pb" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock x:Name="TimerText" Text="00:00:00" FontFamily="{StaticResource MonoFont}"
                           FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                           Margin="0,14,0,0"/>
                <TextBlock x:Name="HintText" FontSize="11" Foreground="{DynamicResource TextFaint}"
                           Margin="2,2,0,0" Text="Select a project below, then press start — or double-click it."/>

                <!-- today divider -->
                <Grid Margin="0,16,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TODAY" Style="{StaticResource EyebrowText}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Height="1" Background="{DynamicResource Border}" Margin="10,0"/>
                    <TextBlock Grid.Column="2" x:Name="TodayTotal" Text="0.0 h" FontSize="12"
                               Foreground="{DynamicResource TextDim}"/>
                </Grid>

                <!-- IsVirtualizing=False: the Window uses SizeToContent="Height", and a
                     virtualized ListBox can report its DesiredSize before all items have been
                     realized/measured, so the window sometimes computes a height that's a row
                     short on the very first layout pass — clipping the last project behind the
                     footer. The list is always small (a handful of projects), so forcing every
                     item to be measured up front costs nothing and removes the race. -->
                <ListBox x:Name="ProjectList" BorderThickness="0" Background="Transparent"
                         MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False"
                         SelectionChanged="ProjectList_SelectionChanged"
                         MouseDoubleClick="ProjectList_DoubleClick" KeyDown="ProjectList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,7"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- BorderThickness is constant (always 1.5) — only BorderBrush toggles
                                             on selection (Transparent -> Accent). Changing BorderThickness itself
                                             via the trigger grew the selected row's occupied size mid-layout,
                                             which could overlap the row below it. Brush-only changes are pure
                                             paint, never layout, so this can't happen. -->
                                        <Border x:Name="row" CornerRadius="8" Background="Transparent"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="1.5" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface3}"/>
                                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="11" Height="11" RadiusX="3" RadiusY="3"
                                           Fill="{Binding Swatch}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Code}" Margin="10,0,0,0"
                                           FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text}"/>
                                <Border Grid.Column="2" Visibility="{Binding LiveVisibility}" Margin="0,0,8,0"
                                        Padding="5,1" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource Live}" VerticalAlignment="Center">
                                    <TextBlock Text="LIVE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource Live}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding HoursText}" FontSize="13"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint" Text="No projects yet — add your first one below."
                           FontSize="12" Foreground="{DynamicResource TextFaint}" Margin="8,6"
                           Visibility="Collapsed"/>

                <!-- footer -->
                <Button Content="📊 View timesheets" Click="Timesheets_Click" Style="{StaticResource Btn}"
                        Margin="0,14,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="＋ Add project" Click="AddProject_Click" Style="{StaticResource Btn}"/>
                    <Button Grid.Column="2" Content="⚙ Settings" Click="Settings_Click" Style="{StaticResource Btn}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
