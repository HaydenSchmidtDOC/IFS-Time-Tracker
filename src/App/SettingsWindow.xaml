<Window x:Class="TimeTracker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420" Height="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- Density slider: 7 evenly-spaced index positions (0-6), not a continuous range — the
             presets themselves (0/.05/.1/.25/.5/1/2h) aren't evenly spaced, so the slider drives
             an index and code maps that to the real value. Notch dots + a filled track segment
             give the snap points a visible target instead of a plain bare handle. -->
        <Style x:Key="DensitySliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="6"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Margin="10,0" Background="{DynamicResource Surface3}"/>
                            <Grid Margin="19,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource BorderStrong}" HorizontalAlignment="Left"/>
                                <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                                <Ellipse Grid.Column="3" Width="6" Height="6" Fill="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                                <Ellipse Grid.Column="4" Width="6" Height="6" Fill="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                                <Ellipse Grid.Column="5" Width="6" Height="6" Fill="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                                <Ellipse Grid.Column="6" Width="6" Height="6" Fill="{DynamicResource BorderStrong}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Track x:Name="PART_Track" Margin="10,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Rectangle Fill="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Rectangle Fill="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="{DynamicResource Accent}"
                                                         Stroke="{DynamicResource Surface}" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.34" Color="#161C2A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface2}" CornerRadius="12,12,0,0"
                    Height="38" MouseLeftButtonDown="TitleBar_Drag">
                <Grid Margin="14,0,8,0">
                    <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" Style="{StaticResource IconBtn}" FontSize="12"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14,20,18">
                <StackPanel>

                    <!-- ===== Tracking ===== -->
                    <TextBlock Text="TRACKING" Style="{StaticResource EyebrowText}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="PromptNoteCheck" Content="Prompt for an optional note on stop/switch"
                              Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowPillCheck" Content="Show the floating status pill"
                              Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowTrayCheck" Content="Show the system-tray icon"
                              Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StartMinimizedCheck" Content="Start minimised (tray/pill only, no window)"
                              Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start automatically when Windows starts"
                              Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Idle threshold before prompting to keep/discard (minutes)"
                                   FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="IdleBox" Style="{StaticResource Input}"
                                 HorizontalContentAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,18"/>

                    <!-- ===== Projects ===== -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="PROJECTS" Style="{StaticResource EyebrowText}" VerticalAlignment="Center"/>
                        <Button Content="＋ Add" HorizontalAlignment="Right" Padding="10,4" FontSize="12"
                                Click="AddProject_Click" Style="{StaticResource Btn}"/>
                    </Grid>
                    <ItemsControl x:Name="ProjectsList"/>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,18"/>

                    <!-- ===== Data location ===== -->
                    <TextBlock Text="DATA LOCATION" Style="{StaticResource EyebrowText}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="DataFolderText" FontSize="12" Foreground="{DynamicResource TextDim}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Open data folder" Click="OpenFolder_Click" Style="{StaticResource Btn}"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="Data lives in this OneDrive folder by default, so it syncs automatically."
                               FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,6,0,14" TextWrapping="Wrap"/>

                    <TextBlock Text="OVERRIDE FOLDER (OPTIONAL)" Style="{StaticResource EyebrowText}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="DataOverrideBox" Style="{StaticResource Input}"
                                 FontSize="12"/>
                        <Button Grid.Column="2" Content="Browse…" Click="BrowseFolder_Click" Style="{StaticResource Btn}"/>
                    </Grid>
                    <TextBlock Text="Leave blank to use the default location above. Changing this takes effect after restarting the app."
                               FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,18"/>

                    <!-- ===== Timesheet chart ===== -->
                    <TextBlock Text="TIMESHEET CHART" Style="{StaticResource EyebrowText}" Margin="0,0,0,4"/>
                    <TextBlock Text="Both settings below are display only — they never change recorded data or the IFS export, only how the chart draws it."
                               FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <CheckBox x:Name="MergeSessionsCheck" Content="Merge every session for a project into one bar"
                              Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,4"
                              Checked="MergeSessionsCheck_Changed" Unchecked="MergeSessionsCheck_Changed"/>
                    <TextBlock Text="Off: only back-to-back sessions with a matching note merge — the same project touched again later in the day gets its own bar."
                               FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="Groups a day's small segments into one &quot;Other&quot; bar (hover it for the exact breakdown)."
                               FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Slider x:Name="DensitySlider" Style="{StaticResource DensitySliderStyle}"
                            ValueChanged="DensitySlider_ValueChanged"/>
                    <TextBlock x:Name="DensityValueText" FontSize="11" Foreground="{DynamicResource TextDim}"
                               FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,18"/>

                    <!-- ===== IFS export ===== -->
                    <TextBlock Text="IFS EXPORT MAPPING" Style="{StaticResource EyebrowText}" Margin="0,0,0,4"/>
                    <TextBlock Text="IFS header ← internal field. Refine once a real IFS export is shared — no code change needed."
                               FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="MappingList"/>
                    <Button Content="＋ Add column" Click="AddMapping_Click" Style="{StaticResource Btn}"
                            HorizontalAlignment="Left" Padding="10,4" FontSize="12" Margin="0,6,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Export date format" FontSize="12.5" Foreground="{DynamicResource TextDim}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="DateFormatBox" Style="{StaticResource Input}"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="◂" Click="PrevMonth_Click" Style="{StaticResource Btn}" Padding="10,7"/>
                        <TextBlock Grid.Column="2" x:Name="MonthLabel" Text="July 2026" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   MinWidth="90" TextAlignment="Center"/>
                        <Button Grid.Column="4" Content="▸" Click="NextMonth_Click" Style="{StaticResource Btn}" Padding="10,7"/>
                    </Grid>
                    <Button Content="⇩ Export month for IFS" Click="Export_Click" Style="{StaticResource BtnAccent}" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ExportResultText" FontSize="11.5" Foreground="{DynamicResource TextDim}"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,18"/>
                    <Button Content="Save" Click="Save_Click" Style="{StaticResource BtnAccent}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
