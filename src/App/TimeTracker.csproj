<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TimeTracker</RootNamespace>
    <AssemblyName>IFS Time Tracker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Per-monitor DPI so the pill and switcher render crisply on any display. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.4.0</Version>
    <Product>IFS Time Tracker</Product>
    <Company>Daifuku Oceania</Company>
    <ApplicationIcon>Assets\time_tracker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TimeTracker.Core.csproj" />
  </ItemGroup>

  <!-- Also exposed as a WPF Resource (separate embedding path from ApplicationIcon above,
       which only bakes the .exe's own native icon) so Window.Icon="Assets/..." can load it
       at runtime for the taskbar/Alt-Tab thumbnail. -->
  <ItemGroup>
    <Resource Include="Assets\time_tracker.ico" />
  </ItemGroup>

  <!-- UseWPF + UseWindowsForms both implicitly global-`using` their namespaces, which collide
       (Application, Brush, Point, KeyEventArgs, MouseEventArgs exist in both). WPF types are used
       unqualified throughout; the few WinForms/Drawing call sites (tray icon, Screen) use explicit
       aliases or fully-qualified names, so it's safe to drop these two from the implicit set. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Single-file, self-contained publish so target machines need nothing installed.
       Publish with:
         dotnet publish src/App/TimeTracker.csproj -c Release -p:PublishSelfContained=true -o dist
       (MSBuild's built-in "PublishProfile" property means a .pubxml file, so this uses a
       differently-named switch to avoid a spurious "profile not found" warning.) -->
  <PropertyGroup Condition="'$(PublishSelfContained)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
