<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TimeTracker</RootNamespace>
    <AssemblyName>IFS Time Tracker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>IFS Time Tracker</Product>
    <Company>Daifuku Oceania</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TimeTracker.Core.csproj" />
  </ItemGroup>

  <!-- Single-file, self-contained publish so target machines need nothing installed.
       Publish with:
         dotnet publish src/TimeTracker.csproj -c Release -r win-x64 -p:PublishProfile=SelfContained -->
  <PropertyGroup Condition="'$(PublishProfile)' == 'SelfContained'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
