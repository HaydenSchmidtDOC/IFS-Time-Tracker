<Window x:Class="TimeTracker.App.AddTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add time" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.32" Color="#20283C"/>
        </Border.Effect>
        <StackPanel Margin="18">
            <Border Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_Drag">
                <TextBlock x:Name="TitleText" Text="Add time" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            </Border>

            <!-- day picker — hidden when editing an existing block, which only adjusts its
                 times (a date move risks crossing into a different month's log file; see
                 CsvLog.UpdateBlock) -->
            <Grid x:Name="DayNavGrid" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="◂" Click="PrevDay_Click" Style="{StaticResource Btn}" Padding="10,5"/>
                <TextBlock Grid.Column="1" x:Name="DayText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="▸" Click="NextDay_Click" Style="{StaticResource Btn}" Padding="10,5"/>
            </Grid>

            <TextBlock Text="PROJECT" Style="{StaticResource EyebrowText}" Margin="0,14,0,6"/>
            <Border Background="{DynamicResource Surface2}" CornerRadius="8">
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProjectsPanel" Margin="4"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="ModeLabel" Text="ADD BY" Style="{StaticResource EyebrowText}" Margin="0,14,0,6"/>
            <ContentControl x:Name="ModeToggleHost" Focusable="False"/>

            <!-- "by amount" content -->
            <Grid x:Name="AmountPanel" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="HOURS" Style="{StaticResource EyebrowText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="AmountHoursBox" Style="{StaticResource Input}" HorizontalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="MINUTES" Style="{StaticResource EyebrowText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="AmountMinutesBox" Style="{StaticResource Input}" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="AmountHintText" FontSize="11" Foreground="{DynamicResource TextFaint}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- "by times" content -->
            <Grid x:Name="TimesPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="START" Style="{StaticResource EyebrowText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="StartTimeBox" Style="{StaticResource Input}" HorizontalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="END" Style="{StaticResource EyebrowText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="EndTimeBox" Style="{StaticResource Input}" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
            <!-- Shown only when the typed/dragged span cleanly spans one or more whole existing
                 blocks — see AddTimeDialog.RefreshTimesHint. A genuinely invalid (partial)
                 overlap still goes through ErrorText below instead, only on pressing Add. -->
            <TextBlock x:Name="TimesHintText" FontSize="11" Foreground="{DynamicResource TextFaint}"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Live}" FontSize="12"
                       Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

            <!-- Edit mode only — see AskEdit. A fresh add collects its note via the normal
                 note-prompt after Commit (matching a live stop/switch), but correcting an
                 existing block is exactly the place to fix a typo in — or add detail to — its
                 note too, rather than leaving it fixed at whatever was recorded originally.
                 Shown regardless of Amount/Times kind, so it sits outside both of those panels. -->
            <TextBlock x:Name="NoteLabel" Text="NOTE" Style="{StaticResource EyebrowText}"
                       Margin="0,14,0,6" Visibility="Collapsed"/>
            <TextBox x:Name="NoteBox" Style="{StaticResource Input}" MaxLength="500" Visibility="Collapsed"/>

            <!-- Edit mode only — see AskEdit. A tiny/short block in the calendar view has no room
                 to show a hover-✕ or drag grips, so deleting (and resizing, via the Start/End
                 boxes above) has to be reachable from here instead. Same confirm-swap idea as
                 DayBlocksWindow's rows and the calendar's own hover-✕ popup. -->
            <Grid x:Name="DeleteRow" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="DeleteLink" Text="Delete this block" FontSize="12"
                           Foreground="{DynamicResource Live}" Cursor="Hand" MouseLeftButtonUp="DeleteLink_Click"/>
                <StackPanel x:Name="DeleteConfirmRow" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Delete this block?" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource Live}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Click="DeleteCancel_Click" Style="{StaticResource Btn}"
                            FontSize="11" Padding="9,4" Margin="0,0,6,0"/>
                    <Button Content="Delete" Click="DeleteConfirm_Click" Style="{StaticResource BtnAccent}"
                            FontSize="11" Padding="9,4" Background="{DynamicResource Live}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Click="Cancel_Click" Style="{StaticResource Btn}"/>
                <Button Grid.Column="2" x:Name="AddButton" Content="Add" Click="Add_Click" Style="{StaticResource BtnAccent}" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
