<Window x:Class="TimeTracker.App.UnsavedChangesPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved changes" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.34" Color="#20283C"/>
        </Border.Effect>
        <StackPanel Margin="16">
            <TextBlock Text="Unsaved changes" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,14"
                       Text="You've made changes in Settings. Save them before closing?"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Click="Cancel_Click" Style="{StaticResource Btn}"/>
                <Button Grid.Column="2" Content="Discard" Click="Discard_Click" Style="{StaticResource Btn}"/>
                <Button Grid.Column="4" Content="Save" Click="Save_Click" Style="{StaticResource BtnAccent}" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
