<Window x:Class="TimeTracker.App.DayBlocksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Day detail" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.34" Color="#20283C"/>
        </Border.Effect>
        <StackPanel Margin="16">
            <Grid Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_Drag">
                <TextBlock x:Name="DateHeading" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <Button Content="✕" Click="CloseBtn_Click" Style="{StaticResource IconBtn}"
                        HorizontalAlignment="Right" Padding="6,2" FontSize="11"/>
            </Grid>

            <TextBlock x:Name="EmptyHint" Text="No time recorded this day." FontSize="12"
                       Foreground="{DynamicResource TextFaint}" Margin="0,16" Visibility="Collapsed"/>

            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel x:Name="RowsPanel"/>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
