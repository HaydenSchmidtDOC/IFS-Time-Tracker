<Window x:Class="TimeTracker.App.AddProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add project" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- Single hue slider: a rainbow track + a plain round thumb. Saturation/Lightness are
             fixed constants in code-behind — deliberately no brightness/opacity control. -->
        <Style x:Key="HueSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="360"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="10" CornerRadius="5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FF0000" Offset="0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                        <GradientStop Color="#00FF00" Offset="0.3333"/>
                                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="0.6667"/>
                                        <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                        <GradientStop Color="#FF0000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="22" Height="22" Fill="White"
                                                         Stroke="#55000000" StrokeThickness="1.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.32" Color="#20283C"/>
        </Border.Effect>
        <StackPanel Margin="18">
            <Border Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_Drag">
                <TextBlock x:Name="HeadingText" Text="New project" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}"/>
            </Border>

            <TextBlock Text="PROJECT CODE" Style="{StaticResource EyebrowText}" Margin="0,14,0,4"/>
            <TextBox x:Name="CodeBox" Style="{StaticResource Input}" MaxLength="40"/>

            <TextBlock Text="ASN NUMBER" Style="{StaticResource EyebrowText}" Margin="0,12,0,4"/>
            <TextBox x:Name="AsnBox" Style="{StaticResource Input}" MaxLength="40"/>

            <TextBlock Text="DESCRIPTION (OPTIONAL)" Style="{StaticResource EyebrowText}" Margin="0,12,0,4"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="80"/>

            <TextBlock Text="COLOUR" Style="{StaticResource EyebrowText}" Margin="0,16,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="HueSlider" Style="{StaticResource HueSliderStyle}"
                        VerticalAlignment="Center"/>
                <Border Grid.Column="1" Width="30" Height="30" Margin="12,0,0,0" CornerRadius="15"
                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1.5">
                    <Border.Background>
                        <SolidColorBrush x:Name="PreviewBrush"/>
                    </Border.Background>
                </Border>
            </Grid>
            <TextBlock x:Name="ColorHelpText"
                       Text="Starts on the colour furthest from your other projects — drag to pick your own."
                       FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Live}" FontSize="12"
                       Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Click="Cancel_Click" Style="{StaticResource Btn}"/>
                <Button Grid.Column="2" x:Name="SaveBtn" Content="Add project" Click="Add_Click" Style="{StaticResource BtnAccent}" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
