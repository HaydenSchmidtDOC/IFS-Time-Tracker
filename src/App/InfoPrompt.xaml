<Window x:Class="TimeTracker.App.InfoPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heads up" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.32" Color="#20283C"/>
        </Border.Effect>
        <StackPanel Margin="16">
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <TextBlock x:Name="Sub" FontSize="12.5" Foreground="{DynamicResource TextDim}"
                       TextWrapping="Wrap" Margin="0,4,0,14"/>
            <Button Content="OK" Click="Ok_Click" Style="{StaticResource BtnAccent}" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>
