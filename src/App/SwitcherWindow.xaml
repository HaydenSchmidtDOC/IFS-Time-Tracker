<Window x:Class="TimeTracker.App.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch project" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontFamily="{StaticResource UiFont}"
        Deactivated="Window_Deactivated" MouseWheel="Window_MouseWheel">
    <Border Background="{DynamicResource Surface}" CornerRadius="14" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.36" Color="#161C2A"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="15,11">
                <TextBlock Text="CHOOSE PROJECT" Style="{StaticResource EyebrowText}"/>
                <TextBlock x:Name="HintText" Text="↑ ↓ · Enter · dbl-click" HorizontalAlignment="Right"
                           FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Border}"/>
            <ItemsControl x:Name="List" Margin="6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Two-line row (title + ASN subtitle) so a long project code always
                             ellipsizes cleanly instead of running under the LIVE badge. -->
                        <Border x:Name="row" CornerRadius="9" Padding="12,9" Margin="0,1"
                                Background="{Binding RowBg}" MouseLeftButtonDown="Row_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="13" Height="13" Fill="{Binding Swatch}"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AsnText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextDim}"
                                               FontFamily="{StaticResource MonoFont}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Visibility="{Binding LiveVisibility}" Margin="8,0,0,0"
                                        Padding="5,1" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource Live}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource Live}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
