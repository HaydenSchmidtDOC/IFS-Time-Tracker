<Window x:Class="TimeTracker.App.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch project" Width="312" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontFamily="{StaticResource UiFont}"
        Deactivated="Window_Deactivated" MouseWheel="Window_MouseWheel">
    <Border Background="{DynamicResource Surface}" CornerRadius="14" Margin="12"
            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="4" Opacity="0.32" Color="#161C2A"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="15,11">
                <TextBlock Text="CHOOSE PROJECT" Style="{StaticResource EyebrowText}"/>
                <TextBlock Text="↑ ↓ · Enter · dbl-click" HorizontalAlignment="Right" FontSize="10.5"
                           Foreground="{DynamicResource TextFaint}"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Border}"/>
            <ItemsControl x:Name="List" Margin="6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" CornerRadius="9" Padding="12,10" Margin="0,1"
                                Background="{Binding RowBg}" MouseLeftButtonDown="Row_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="13" Height="13" Fill="{Binding Swatch}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Code}" Margin="12,0,0,0"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text}"/>
                                <Border Grid.Column="2" Visibility="{Binding LiveVisibility}" Margin="0,0,8,0"
                                        Padding="5,1" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource Live}" VerticalAlignment="Center">
                                    <TextBlock Text="LIVE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource Live}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding AsnText}" FontSize="11"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
