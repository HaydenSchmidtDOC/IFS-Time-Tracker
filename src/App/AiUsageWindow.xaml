<Window x:Class="TimeTracker.App.AiUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI usage" Width="900" Height="560" MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="PeriodBox" Style="{StaticResource Dropdown}" Width="130" Margin="0,0,10,0"
                      SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="ProviderBox" Style="{StaticResource Dropdown}" Width="130" Margin="0,0,14,0"
                      SelectionChanged="Filter_Changed"/>
            <CheckBox x:Name="UnassignedOnly" Content="Unassigned only" VerticalAlignment="Center"
                      Foreground="{DynamicResource Text}" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                  RowBackground="Transparent" AlternatingRowBackground="Transparent"
                  HorizontalGridLinesBrush="{DynamicResource Border}" Foreground="{DynamicResource Text}"
                  SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Binding="{Binding When}" Width="140"/>
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="80"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="90"/>
                <DataGridTextColumn Header="Tokens" Binding="{Binding TokensText}" Width="90"/>
                <DataGridTextColumn Header="Cost" Binding="{Binding CostText}" Width="80"/>
                <DataGridTemplateColumn Header="Project" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource Dropdown}" ItemsSource="{Binding Choices}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,10,0,0" FontSize="12"
                   Foreground="{DynamicResource TextDim}"/>
    </Grid>
</Window>
