<Window x:Class="TimeTracker.App.UpdatePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.32" Color="#20283C"/>
        </Border.Effect>
        <StackPanel Margin="18">
            <TextBlock Text="A new version is available" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Sub" FontSize="12.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                       Margin="0,6,0,4"/>
            <Button x:Name="ReleaseNotesButton" Content="View release notes" Click="ReleaseNotes_Click"
                    Style="{StaticResource Btn}" HorizontalAlignment="Left" Padding="10,4" FontSize="12"
                    Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Later" Click="Later_Click" Style="{StaticResource Btn}"/>
                <Button Grid.Column="2" Content="Update now" Click="UpdateNow_Click" Style="{StaticResource BtnAccent}" IsDefault="True"/>
            </Grid>
            <Button Content="Skip this version" Click="Skip_Click" Style="{StaticResource Btn}"
                    HorizontalAlignment="Center" Padding="10,4" FontSize="11.5" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>