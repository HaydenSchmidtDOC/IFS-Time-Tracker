<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Custom theme: near-black hacker/terminal look, surfaces and borders tinted green, neon
         green accent. Same key set as Light.xaml/Dark.xaml. -->
    <SolidColorBrush x:Key="Bg"           Color="#070B09"/>
    <SolidColorBrush x:Key="Surface"      Color="#0D1712"/>
    <SolidColorBrush x:Key="Surface2"     Color="#12211A"/>
    <SolidColorBrush x:Key="Surface3"     Color="#182C22"/>
    <SolidColorBrush x:Key="Border"       Color="#1F3B2C"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#2B5039"/>
    <SolidColorBrush x:Key="Text"         Color="#DFFFEA"/>
    <SolidColorBrush x:Key="TextDim"      Color="#8FC4A3"/>
    <SolidColorBrush x:Key="TextFaint"    Color="#5C8A6E"/>
    <SolidColorBrush x:Key="Accent"       Color="#43E07A"/>
    <SolidColorBrush x:Key="AccentInk"    Color="#0A1015"/>
    <SolidColorBrush x:Key="Live"         Color="#FF5C5C"/>
    <Color x:Key="AccentColor">#43E07A</Color>
</ResourceDictionary>
