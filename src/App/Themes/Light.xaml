<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cool slate neutrals so per-project colours pop; single slate-blue accent. -->
    <SolidColorBrush x:Key="Bg"           Color="#E7EAEE"/>
    <SolidColorBrush x:Key="Surface"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2"     Color="#F3F5F8"/>
    <SolidColorBrush x:Key="Surface3"     Color="#EAEDF1"/>
    <SolidColorBrush x:Key="Border"       Color="#D5DAE1"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#C2C9D2"/>
    <SolidColorBrush x:Key="Text"         Color="#191E26"/>
    <SolidColorBrush x:Key="TextDim"      Color="#586172"/>
    <SolidColorBrush x:Key="TextFaint"    Color="#8791A0"/>
    <SolidColorBrush x:Key="Accent"       Color="#2D6B8F"/>
    <SolidColorBrush x:Key="AccentInk"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Live"         Color="#E5484D"/>
    <Color x:Key="AccentColor">#2D6B8F</Color>
</ResourceDictionary>
