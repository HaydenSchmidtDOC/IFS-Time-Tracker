<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same keys as Light.xaml; contrast kept legible and the accent works on the dark ground. -->
    <SolidColorBrush x:Key="Bg"           Color="#0C0F12"/>
    <SolidColorBrush x:Key="Surface"      Color="#191D23"/>
    <SolidColorBrush x:Key="Surface2"     Color="#20262D"/>
    <SolidColorBrush x:Key="Surface3"     Color="#262D35"/>
    <SolidColorBrush x:Key="Border"       Color="#2B333C"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#3A434E"/>
    <SolidColorBrush x:Key="Text"         Color="#E7ECF2"/>
    <SolidColorBrush x:Key="TextDim"      Color="#9BA6B3"/>
    <SolidColorBrush x:Key="TextFaint"    Color="#6A7583"/>
    <SolidColorBrush x:Key="Accent"       Color="#4EA3D6"/>
    <SolidColorBrush x:Key="AccentInk"    Color="#0A1015"/>
    <SolidColorBrush x:Key="Live"         Color="#F2565B"/>
    <Color x:Key="AccentColor">#4EA3D6</Color>
</ResourceDictionary>
