<Window x:Class="TimeTracker.App.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tracking" Height="52" Width="216"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Border x:Name="Pill" Background="{DynamicResource Surface}" CornerRadius="26"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            MouseLeftButtonDown="Pill_Down" MouseMove="Pill_Move" MouseLeftButtonUp="Pill_Up"
            MouseRightButtonUp="Pill_RightClick"
            Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="3" Opacity="0.30" Color="#161C2A"/>
        </Border.Effect>
        <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- colour dot: click to collapse/expand -->
            <Ellipse Grid.Column="0" x:Name="Dot" Width="16" Height="16" Margin="6,0,0,0"
                     Fill="{DynamicResource TextFaint}" Cursor="Hand"
                     MouseLeftButtonUp="Dot_Click" ToolTip="Collapse / expand"/>

            <!-- body: code + time (collapses away) -->
            <StackPanel Grid.Column="1" x:Name="Body" Orientation="Horizontal" Margin="10,0,4,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="CodeText" Text="—" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeText" Text="00:00:00" FontFamily="{StaticResource MonoFont}"
                           FontSize="13" Foreground="{DynamicResource TextDim}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- start/stop toggle -->
            <Button Grid.Column="2" x:Name="ToggleBtn" Width="26" Height="26" Margin="4,0"
                    Click="Toggle_Click" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tb" CornerRadius="13" Background="{DynamicResource Surface3}">
                            <TextBlock x:Name="tt" Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tt" Property="Foreground" Value="{DynamicResource AccentInk}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Grid.Column="3" x:Name="Grip" Text="⋮⋮" FontSize="12" Margin="2,0,4,0"
                       Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
