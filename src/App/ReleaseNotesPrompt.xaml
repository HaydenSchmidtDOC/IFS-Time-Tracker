<Window x:Class="TimeTracker.App.ReleaseNotesPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.32" Color="#20283C"/>
        </Border.Effect>
        <StackPanel Margin="18">
            <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,8,0,16">
                <TextBlock x:Name="NotesText" FontSize="12.5" Foreground="{DynamicResource TextDim}"
                           TextWrapping="Wrap" LineHeight="18"/>
            </ScrollViewer>
            <Button Content="OK" Click="Ok_Click" Style="{StaticResource BtnAccent}" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>