<Window x:Class="TimeTracker.App.IdlePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="You were away" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="12"
            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="3" Opacity="0.26" Color="#20283C"/>
        </Border.Effect>
        <StackPanel Margin="16">
            <TextBlock Text="You were away" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}"/>
            <TextBlock x:Name="Sub" FontSize="12.5" Foreground="{DynamicResource TextDim}"
                       TextWrapping="Wrap" Margin="0,4,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Discard" Click="Discard_Click" Style="{StaticResource Btn}"/>
                <Button Grid.Column="2" Content="Keep" Click="Keep_Click" Style="{StaticResource BtnAccent}" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
